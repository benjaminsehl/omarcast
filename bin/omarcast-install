#!/bin/bash
# Deploy this checkout as a normal, validated user plugin directory. Omarchy
# rejects symlinked packages; the Git checkout remains the editable source.
set -euo pipefail
case ${1:-} in
  ""|--no-restart) ;;
  *) printf 'Usage: omarcast-install [--no-restart]\n' >&2; exit 1 ;;
esac
src="$(cd "$(dirname "$(readlink -f "$0")")/../plugin" && pwd)"
dest="$HOME/.config/omarchy/plugins/sehl.omarcast"

omarchy plugin validate "$src"
if [[ -L "$dest" ]]; then
  rm -- "$dest"
elif [[ -e "$dest" && ! -d "$dest" ]]; then
  printf 'Not a plugin directory: %s\n' "$dest" >&2
  exit 1
fi
mkdir -p "$dest"
rsync -a --delete --exclude='.git/' "$src/" "$dest/"
omarchy plugin validate "$dest"
printf 'Omarcast deployed: %s -> %s\n' "$src" "$dest"

if [[ ${1:-} != --no-restart ]]; then
  omarchy restart shell
  omarchy plugin enable sehl.omarcast
fi
