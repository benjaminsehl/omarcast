#!/bin/bash
# dev/shot '<payload json>' [out.png] — run the harness, screenshot, exit.
cd "$(dirname "$0")/.."
out="${2:-/tmp/omarcast-shot.png}"
(OMARCAST_PAYLOAD="${1:-}" timeout 6 qs -p dev 2>&1 | grep -vE "portal|INFO|^\s*$" | cut -c1-300 | head -20) &
sleep "${SHOT_DELAY:-3}"
grim -g "${SHOT_GEOM:-820,310 920x620}" "$out"
magick "$out" -resize 1100x "$out" 2>/dev/null || true
wait
