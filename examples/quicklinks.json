[
  // Copy to ~/.config/omarcast/quicklinks.json (or run "Edit Quicklinks").
  // Type "<keyword> <query>" in Omarcast. {query} is URL-encoded.
  { "keyword": "gh", "name": "GitHub", "url": "https://github.com/search?q={query}" },
  { "keyword": "jira", "name": "Jira", "url": "https://example.atlassian.net/issues/?jql=text~\"{query}\"" }
]
